{% assign is_enabled = app.metafields.nizbay_widgets.review_carousel %}

{% if is_enabled == 'true' or is_enabled == true %}
  <div class="nizbay-carousel-widget" style="padding: 20px; background: #f8fafc; border-radius: 8px;">
    <h4 style="margin-bottom: 12px;">Top Customer Reviews</h4>
    <p style="color: #64748b;">Carousel reviews display here...</p>
  </div>
{% endif %}

{% schema %}
{
  "name": "Review Carousel",
  "target": "section",
  "enabled_on": {
    "templates": ["product", "index"]
  },
  "settings": []
}
{% endschema %}